# Set XINGCHEN_DOMAIN in the Caddy process environment before loading this file.
# Merge only this virtual host into the existing edge configuration.
# Preserve existing global options, other sites and certificate storage.
{$XINGCHEN_DOMAIN} {
    @initialization path /initialize /initialize/* /api/auth/initialize /api/auth/initialize/*
    handle @initialization {
        respond 404
    }
    handle {
        reverse_proxy xingchen-core:3200 {
            header_up -Forwarded
            header_up -X-Forwarded-For
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$XINGCHEN_DOMAIN}
            header_up Host {$XINGCHEN_DOMAIN}
        }
    }
    header Strict-Transport-Security "max-age=31536000"
}
