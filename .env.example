# Copy to .env and replace the placeholders before starting the container.
XINGCHEN_VERSION=0.1.0-SNAPSHOT
XINGCHEN_GIT_COMMIT=unavailable
XINGCHEN_CONSOLE_ADMIN_USER=replace-with-admin-name
XINGCHEN_CONSOLE_ADMIN_PASSWORD=CHANGE-ME
# Container network binding requires this explicit opt-in and valid admin credentials.
XINGCHEN_CONSOLE_ALLOW_REMOTE=true
XINGCHEN_CONSOLE_COOKIE_SECURE=false
XINGCHEN_PUBLIC_BASE_URL=
XINGCHEN_OWNER_ID=
# These endpoints are examples only. Integrations remain disabled by default.
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_HTTP_URL=http://127.0.0.1:3000
DSH_BASE_URL=http://127.0.0.1:3190
